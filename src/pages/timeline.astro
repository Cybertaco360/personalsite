---
export const prerender = true;

import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import {
    timelineData,
    getTimelineByType,
} from "@utils/timeline";
import IconifyLoader from "@components/common/iconifyLoader.astro";
import TimelineItem from "@components/data/timelineItem.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";

const title = LinkPresets[LinkPreset.Timeline].name;
const subtitle =
    "Projects, experiences, competitions, and chapters that have mattered to me.";

const getTypeIcon = (type: string) => {
    switch (type) {
        case "education":
            return "material-symbols:school";
        case "work":
            return "material-symbols:work";
        case "project":
            return "material-symbols:code";
        case "achievement":
            return "material-symbols:emoji-events";
        case "community":
            return "material-symbols:groups";
        case "writing":
            return "material-symbols:edit-document";
        case "milestone":
            return "material-symbols:flag";
        default:
            return "material-symbols:event";
    }
};

const allIcons = timelineData
    .map((item) => item.icon || getTypeIcon(item.type))
    .filter(Boolean);

const allTimelineItems = getTimelineByType();
---

<GridLayout title={title} description={subtitle}>
    <IconifyLoader preloadIcons={allIcons} />

    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />

            <div class="flex flex-col items-start justify-center mb-10">
                <h1 class="text-4xl font-bold text-black/90 dark:text-white/90 mb-3">
                    Timeline
                </h1>

                <p class="text-lg text-black/60 dark:text-white/60 max-w-2xl">
                    Not a complete autobiography or résumé—just a collection of
                    projects, experiences, competitions, and chapters that have
                    shaped what I enjoy learning and building.
                </p>
            </div>

            <div class="relative">
                <div
                    class="absolute left-6 top-0 bottom-0 w-0.5
                    bg-gray-200 dark:bg-gray-700"
                ></div>

                <div class="space-y-8">
                    {allTimelineItems.map((item) => (
                        <TimelineItem
                            item={item}
                            layout="timeline"
                            showTimeline={true}
                            size="medium"
                        />
                    ))}
                </div>
            </div>
        </div>
    </div>
</GridLayout>

<script>
    // 确保图标库已加载，触发时间线项目的图标渲染
    if (typeof window !== 'undefined' && window.__iconifyLoader) {
        window.__iconifyLoader.onLoad(() => {
            document.querySelectorAll('.timeline-item').forEach(item => {
                item.dispatchEvent(new CustomEvent('iconify-ready'));
            });
        });
        window.__iconifyLoader.load().catch(console.error);
    }

    // 处理页面从 bfcache 恢复（前进/后退导航）
    window.addEventListener('pageshow', (event) => {
        if (event.persisted && window.__iconifyLoader) {
            setTimeout(() => window.__iconifyLoader.load().catch(console.error), 100);
        }
    });
</script>